 #route-pending-actions[hidden]{display:none}
 #route-retry{min-height:44px;padding:10px 20px;border:1px solid var(--ds-line,#3a3a48);border-radius:12px;background:var(--ds-panel,#131b26);color:var(--ds-text,#F8FAFC);font:inherit;cursor:pointer}
