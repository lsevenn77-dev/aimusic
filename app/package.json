{
  "name": "aifect-app",
  "private": true,
  "description": "AIFECT Android/iOS shell around https://aifect.co.kr",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --android",
    "android:debug": "cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-media-session": "^8.0.32"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
