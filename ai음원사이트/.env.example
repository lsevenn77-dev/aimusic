# Copy required settings into ignored .dev.vars for local development.
# Production secrets belong in Sites runtime settings, never in Git.
# Enable dubbing only after the new migrations are approved and applied.
DUBBING_ENABLED=false
# Separate approval is needed before making billable requests.
DUBBING_AI_ENABLED=false
OPENAI_API_KEY=
# Saigram's LLM_API_KEY can be reused as a server-only fallback.
LLM_API_KEY=
# Phase 2 server-only Pika credential. Never include it in browser bundles.
PIKA_API_KEY=
# Start the independent transcoder/dubbing.py worker before enabling sound jobs.
DUBBING_SOUND_ENABLED=false
# Enable only after approval for actual Pika generation charges.
DUBBING_PAID_API_ENABLED=false
# Separate approval gate. Charge the confirmed admin price (default 50G).
DUBBING_GOLD_ENABLED=false
# Web GPT rewarded inventory. Keep disabled until AdSense/Ad Manager approval.
# Supply the real /NETWORK_CODE/AD_UNIT path; AdMob IDs cannot be reused here.
# Web GPT grants are client callbacks (not signed server-side verification).
DUBBING_REWARDED_ADS_ENABLED=false
DUBBING_REWARDED_AD_UNIT=
# Separate staged rollout: run the dubbing worker for final mixes before enabling.
DUBBING_RECORDING_ENABLED=false
# Optional reporting conversion only. Leave empty until an actual rate/date is supplied.
DUBBING_USD_KRW_RATE=
DUBBING_USD_KRW_AS_OF=
AUTH_PEPPER=replace-with-random-secret
TRANSCODER_TOKEN=replace-with-random-worker-token
BILLING_CHECKOUT_ENABLED=false
BILLING_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BILLING_WORKER_TOKEN=replace-with-random-billing-worker-token
NICEPAY_CLIENT_ID=replace-with-merchant-client-id
NICEPAY_SECRET_KEY=replace-with-merchant-secret
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-if-enabled
KAKAO_APP_ID=replace-with-numeric-kakao-app-id-for-native-token-verification
APPLE_CLIENT_ID=kr.co.aifect.web
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY=replace-with-private-key-in-runtime-only
# Creator payouts: base64 32-byte key sealing account and resident numbers; losing it makes stored details unreadable.
PAYOUT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Comma-separated user ids allowed to open the payout admin page (#admin).
ADMIN_USER_IDS=replace-with-operator-user-id

# Approved Google Ad Manager audio-only VAST tag. Empty disables web audio ads.
# Initial rollout: Korean traffic only; other regions require a verified IMA CMP.
WEB_AUDIO_AD_TAG_URL=
# Activate only after the website and this display unit are approved.
WEB_UPLOAD_ADS_ENABLED=false
WEB_UPLOAD_AD_CLIENT=
WEB_UPLOAD_AD_SLOT=

# Keep both sales gates off until NICEPAY approves the corresponding product flow.
GOLD_CHECKOUT_ENABLED=false
# Confirmed effective web PG fee in basis points, including its VAT. No guessed default.
GOLD_WEB_FEE_BP=
# Screen-only reviewer ids; cannot approve real charges, even after live sales open.
BILLING_REVIEW_USER_IDS=
BILLING_REVIEW_UNTIL=
# Firebase HTTP v1 service-account JSON: hosted secret only, never an Android asset.
FCM_SERVICE_ACCOUNT=

# Server-only Gemini music classification
GEMINI_API_KEY=
GEMINI_MUSIC_MODEL=gemini-3.5-flash-lite
GEMINI_MUSIC_DAILY_LIMIT=500
MUSIC_CLASSIFICATION_ADMIN_TOKEN=
# Admin dashboard password verifier; store only as a hosted secret.
# AIFECT member sessions remain separate. Changing this revokes admin sessions.
ADMIN_PASSWORD_HASH=
