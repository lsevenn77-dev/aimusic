{
  "name": "aifect",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:play": "eslint --config eslint.play.config.mjs dist/play-page.js server/play.js tests/play.test.mjs tests/preview-play.mjs",
    "typecheck:play": "tsc -p tsconfig.play.json",
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --port 4174",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@soundtouchjs/core": "2.1.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "esbuild": "^0.25.9",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "wrangler": "^4.32.0",
    "ws": "8.21.0"
  }
}
